---
const { title } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---
<header class="site-title">
  <div class="logo">FL</div>
  <div>
    <h1>{title}</h1>
    <p class="lead">Android drawing preview and pointer diagnostics</p>
    <nav class="nav">
      <a href={`${base}/`} class="active">Home</a>
      <a href={`${base}/about/`}>About</a>
      <a href={`${base}/install/`}>Install</a>
      <a href={`${base}/releases/`}>Releases</a>
      <a href="https://github.com/cmwen/lenovo-graphics-pad" target="_blank" rel="noopener">Repository</a>
    </nav>
  </div>
</header>
